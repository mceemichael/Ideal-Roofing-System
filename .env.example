# ---------------------------------------------------------------------------
# Sanity. `npx sanity@latest init --env` fills the first three in for you.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Read token. Only needed for draft previews in Sanity Studio.
SANITY_API_READ_TOKEN=

# Shared secret for the /api/revalidate webhook, so Sanity can tell Next.js
# to rebuild a page when you publish. Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# Write token, needed ONLY for the comment form. Without it the form shows a
# polite "not configured yet" message and nothing else breaks.
# Create at sanity.io/manage -> API -> Tokens, with Editor permissions.
# Treat it like a password: it can write to your content.
SANITY_API_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Where /wp-content/uploads/* is served from after cutover.
# Leave unset and it proxies from the old WordPress host (fine during the
# 30-day overlap). Set it to your Vercel Blob / R2 / S3 origin before you
# decommission WordPress, or every historical image URL dies with it.
# ---------------------------------------------------------------------------
MEDIA_ORIGIN=

# Canonical site URL. Used for canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://idealroofingsystem.com
